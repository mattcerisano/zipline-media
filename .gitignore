# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist


# misc
.DS_Store
*.pem

# ffmpeg two-pass encode artifacts. `*.log` below does not catch the .mbtree
# half, which is how a 16 MB one reached the repo root in #18.
ffmpeg2pass-*.log
ffmpeg2pass-*.log.mbtree

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
*.log

# massive source videos / reels only
public/broadway-reel.mp4
# Keep individual category/hero videos allowed
Website photos/
.env*.local

# Claude local config
.claude/

# Backup files
*.bak


ui-harness-shots/

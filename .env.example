# Copy to .env.local for local development. In production, set these in
# Vercel → Project → Settings → Environment Variables.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google account linking (see docs/GOOGLE_SETUP.md) ---
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
# Must exactly match an Authorized redirect URI on the Google OAuth client.
# Production: https://zipline.media/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional: signs the OAuth state parameter. Falls back to
# SUPABASE_SERVICE_ROLE_KEY when unset.
# OAUTH_STATE_SECRET=any-long-random-string

# --- Scheduling ---
# The timezone stored call times ("8:00 AM") are expressed in. Any IANA name.
# Defaults to America/New_York. Set this if the studio moves — the server runs
# in UTC, so an unset or wrong value shifts every pushed call time.
# STUDIO_TIMEZONE=America/New_York

# Shared secret for the public ICS feed (/api/calendar). When set, the feed is
# only readable at /api/calendar?token=... — the Integrations Hub shows the
# full URL to copy. When unset the feed is readable by anyone who knows the
# path, including job titles, client names, and notes.
# CALENDAR_FEED_TOKEN=any-long-random-string

# Set by Vercel on cron invocations; when present the calendar-sync cron
# requires it, so outsiders can't trigger syncs.
# CRON_SECRET=any-long-random-string

# --- QuickBooks (read-only billing on production cards) ---
# Create an app at developer.intuit.com → Dashboard → Create an app (QuickBooks
# Online, Accounting scope). Keys are per-environment: use the Development keys
# with the sandbox company first, then the Production keys after review.
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# Must exactly match a Redirect URI on the Intuit app.
# Production: https://zipline.media/api/auth/quickbooks/callback
# QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/auth/quickbooks/callback
# "sandbox" (default) or "production" — controls which QuickBooks API host is used.
# QUICKBOOKS_ENVIRONMENT=sandbox

# --- Claude assistant (suggest-only AI features) ---
# From console.anthropic.com → API keys. Server-side only; without it the
# assistant features hide themselves.
# ANTHROPIC_API_KEY=

# --- Optional integrations (features degrade gracefully without them) ---
# GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_CX=
# VIMEO_ACCESS_TOKEN=
# FRAMEIO_DEVELOPER_TOKEN=
# DISCORD_WEBHOOK_URL=

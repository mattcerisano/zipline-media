{
  "name": "zipline-media",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "concurrently \"next dev\" \"wait-on tcp:3000 && electron .\"",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.ziplinemedia.app",
    "productName": "Zipline Media",
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hello-pangea/dnd": "^18.0.1",
    "@huggingface/transformers": "^4.2.0",
    "@supabase/supabase-js": "^2.103.0",
    "@vercel/analytics": "^1.6.1",
    "dompurify": "^3.4.11",
    "duckduckgo-images-api": "^1.0.5",
    "framer-motion": "^12.28.1",
    "google-it": "^1.6.4",
    "googlethis": "^1.8.0",
    "ics": "^3.12.0",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.562.0",
    "next": "16.1.4",
    "pg": "^8.21.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-google-autocomplete": "^2.7.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "concurrently": "^9.2.1",
    "electron": "^40.1.0",
    "electron-builder": "^26.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.3"
  }
}
